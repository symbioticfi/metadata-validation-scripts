{
    "type": "object",
    "description": "Protocols and RWAs with optional vault, pool, or market identifiers.",
    "properties": {
        "protocols": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "protocol": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                    },
                    "ids": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                            "type": "string"
                        }
                    },
                    "subaccounts": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 48,
                        "uniqueItems": true,
                        "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                        }
                    }
                },
                "required": ["protocol", "ids"],
                "additionalProperties": false
            }
        }
    },
    "required": ["protocols"],
    "additionalProperties": false
}
