{
    "type": "object",
    "description": "Protocols and RWAs with optional vault, pool, or market identifiers.",
    "properties": {
        "protocols": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "protocol": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                    },
                    "addresses": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "pattern": "^0x(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
                        }
                    }
                },
                "required": ["protocol", "addresses"],
                "additionalProperties": false
            }
        }
    },
    "required": ["protocols"],
    "additionalProperties": false
}
