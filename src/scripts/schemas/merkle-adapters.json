{
    "type": "object",
    "description": "Chain-scoped protocols and RWAs with optional vault, pool, or market identifiers.",
    "properties": {
        "chains": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "chainId": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                    },
                    "protocols": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "protocol": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                                },
                                "ids": {
                                    "type": "array",
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "subaccounts": {
                                    "type": "array",
                                    "minItems": 1,
                                    "maxItems": 48,
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255
                                    }
                                }
                            },
                            "required": ["protocol", "ids"],
                            "additionalProperties": false
                        }
                    }
                },
                "required": ["chainId", "protocols"],
                "additionalProperties": false
            }
        }
    },
    "required": ["chains"],
    "additionalProperties": false
}
